{
  "name": "@repo/db-migrator",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "update": "tsx src/update/run.ts",
    "migrate": "tsx src/update/run.ts --alias=migrate",
    "migrate:down": "tsx src/update/run.ts --alias=migrate:down --down",
    "migrate:status": "tsx src/update/run.ts --alias=migrate:status --status",
    "seed": "tsx src/seed/run.ts",
    "reset": "tsx src/reset/run.ts",
    "lint": "eslint src/ seeds/ test/ --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "@repo/jest-presets/node",
    "globalSetup": "<rootDir>/test/support/mongo-global-setup.ts",
    "globalTeardown": "<rootDir>/test/support/mongo-global-teardown.ts",
    "moduleNameMapper": {
      "^@repo/domain/(.*)$": "<rootDir>/../../packages/domain/src/$1"
    }
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@repo/domain": "workspace:*",
    "migrate-mongo": "^14.0.7",
    "mongodb": "~7.5.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
