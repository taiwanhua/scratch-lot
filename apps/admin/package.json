    "@repo/i18n": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/project-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.12.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
