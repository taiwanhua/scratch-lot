# apps/e2e 的環境變數範本。要使用本專案的設定,複製成 apps/e2e/.env;已有檔案只補缺項。
# 未設定時使用 src/config.ts 的程式預設值,不會自動讀取本範例;多專案並行須分開設定 DB、埠、Compose 名稱與 bucket。
#
# 這裡的帳密全是**測試值**,只會用在本機 / CI 起的拋棄式資料庫上。
# 任何真實環境的密碼、金鑰一律不放這裡,也不放進 e2e.yml 的 inputs —— 那些在 Secret Manager
#(清單見 docs/env-registry.md)。

# admin 與 api 必須同一個主機名(refresh cookie 是 SameSite=Lax,localhost 與 127.0.0.1 算兩個站台)
E2E_HOST=127.0.0.1
E2E_API_PORT=5101
E2E_ADMIN_PORT=4301

# 空 = harness 自起 mongodb-memory-server;CI 填 service container 的位址
# E2E_MONGODB_URI=mongodb://127.0.0.1:27017/scratch_lot_e2e
E2E_DB_NAME=scratch_lot_e2e

# seed 建出來的超級管理員(對應 ROOT_ADMIN_ACCOUNT / ROOT_ADMIN_EMAIL / ROOT_ADMIN_PASSWORD)
E2E_ROOT_ACCOUNT=root
E2E_ROOT_EMAIL=e2e-root@scratch-lot.test
E2E_ROOT_PASSWORD=e2e-root-pw-2026

# 劇本自己建出來的 +tenant / +user 共用密碼(密碼規則:8 碼以上、非純數字)
E2E_MEMBER_PASSWORD=e2e-member-pw-2026

# api 缺 JWT_SECRET 會啟動失敗,e2e 給假值即可
E2E_JWT_SECRET=e2e-only-jwt-secret

# fake GCS(劇本 11 / 15,#402):harness 以 apps/e2e/docker-compose.yml 起 fsouza/fake-gcs-server,
# api 以 GCS_API_ENDPOINT 指過去。本機沒有 Docker(或 Docker Desktop 沒開)→ 這兩條 skip、其餘照跑
# E2E_COMPOSE_PROJECT 是 Compose 專案名(容器與網路的名稱前綴);同機跑第二個專案的 e2e 時連同埠一起換
E2E_COMPOSE_PROJECT=scratch-lot-e2e
E2E_GCS_PORT=4443
E2E_GCS_BUCKET_PUBLIC=scratch-lot-e2e-public
E2E_GCS_BUCKET_PRIVATE=scratch-lot-e2e-private
# 1 = 起不了 fake GCS 就整個失敗(CI 的 e2e.yml 設了;本機預設不設,沒有 Docker 就 skip 那兩條)
# E2E_GCS_REQUIRED=1

# 簽名網址用的**假**憑證 —— 僅 fake GCS 用,無任何真實權限(fake GCS 不驗簽章;不是任何 GCP 服務帳號)。
# 本機 / CI 沒有 ADC,V4 簽名要一把私鑰才算得出來。私鑰留空 = harness 每次啟動現產一把 RSA 金鑰,
# 所以 repo 裡不放任何金鑰;真要固定一把(例如想重現某次簽出來的網址)就填 PKCS#8 PEM,
# 寫成一行、換行處改成字面的「反斜線 + n」(api 讀進來會還原)
E2E_GCS_FAKE_CLIENT_EMAIL=fake-gcs@scratch-lot-e2e.test
# E2E_GCS_FAKE_PRIVATE_KEY=

# 只跑標題符合的劇本(Playwright 的 grep;空 = 全部)
# E2E_GREP=劇本 7

# 本機反覆跑同一條劇本時的兩個省時開關
# E2E_SKIP_BUILD=1   # 不重新 build api / admin
# E2E_SKIP_STACK=1   # 不起 stack,直接打已經跑著的 api / admin
