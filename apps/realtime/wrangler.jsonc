{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 即時通道:Worker(入口,驗證訂閱憑證 / 送出信號簽章)+ Durable Object `TenantHub`(每租戶一個 `hub:<租戶 id>`)。
  // 三個環境各一個 Worker 與網域,部署設定另行接線;本檔只描述本機開發(`wrangler dev`)與測試共用的部分。
  // 密鑰 REALTIME_TICKET_SECRET / REALTIME_PUBLISH_SECRET:本機放 .dev.vars,雲端放 Wrangler secret。
  "name": "realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "TENANT_HUB", "class_name": "TenantHub" }],
  },
  // 免費方案只能用 SQLite 儲存的 Durable Object
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantHub"] }],
}
