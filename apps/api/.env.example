# MongoDB 連線字串(必填,沒有預設值:缺少、空字串或純空白即啟動失敗)。埠與資料庫名要對到
# 根目錄 docker-compose.yml 起的 mongo(根 .env 的 LOCAL_MONGO_PORT;見根目錄 .env.example)
MONGODB_URI=mongodb://localhost:27017/scratch-lot
PORT=5001

# access token 簽章密鑰(必填,缺少即啟動失敗;雲端存 Secret Manager)。本地隨便給一段即可,
# 正式值用 `openssl rand -base64 32` 產生。變數清單與說明見 docs/env-registry.md
JWT_SECRET=local-dev-jwt-secret-change-me

# 欄位級加密金鑰(32 bytes 的 base64;雲端存 Secret Manager)。沒有預設值:未設時 api 照常啟動,
# 讀寫加密欄位(會員的 nationalId)的那一刻才拋錯。下面是本地專用的固定值,正式值用 `openssl rand -base64 32` 產生
FIELD_ENCRYPTION_KEY=bG9jYWwtZGV2LWZpZWxkLWVuY3J5cHRpb24ta2V5ISE=

# 以下皆有內建預設值,不設也能跑(雲端三環境的值放 deploy/env/<環境>.yaml,本地只在需要時打開)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
# COOKIE_DOMAIN=            # 本地不設;雲端填 api 與後台共同的網域(如 .example.com)

# 寄信(啟用信 / 重設密碼信;ADR-0010)。RESEND_API_KEY 不設 → 信件只印到 api 的 stdout、不真寄出(從 log 拿連結)
# RESEND_API_KEY=
# MAIL_ALLOWLIST=           # 逗號分隔;有值時只寄名單內的信箱。三個雲端環境都不設(= 不限收件人),留給本機防誤寄用
# ADMIN_APP_URL=http://localhost:3001   # 信件連結指向的後台網址
# ACTIVATION_TOKEN_TTL=7d
# PASSWORD_RESET_TOKEN_TTL=30m
# WORKFLOW_MAIL_ENABLED=true   # 審核流程通知信;"true" 才寄,其他值 / 未設 = 只寫 log

# 檔案儲存(商標;ADR-0010)。GCS_BUCKET_PRIVATE 不設 → 簽名網址是假的、檔案不會真的上傳(本地即此模式);
# 本機沒有 GCP 憑證,填了 bucket 名稱也簽不出網址 — 真的要驗上傳請部署到 dev
# GCS_BUCKET_PRIVATE=
# GCS_BUCKET_PUBLIC=
# GCS_SIGNED_URL_TTL=1h     # 簽名讀取網址效期(上傳網址固定 10 分鐘)

# GraphQL Sandbox / introspection:本地(NODE_ENV 不是 production)不看此值、恆開;只在雲端 dev 設 "true"
# GRAPHQL_SANDBOX=true
