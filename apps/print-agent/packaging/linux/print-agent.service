[Unit]
Description=Print agent (receipt printer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=print-agent
Group=print-agent
ExecStart=/opt/print-agent/print-agent run
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/print-agent /var/log/print-agent

[Install]
WantedBy=multi-user.target
