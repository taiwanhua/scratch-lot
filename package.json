{
  "name": "scratch-lot",
  "private": true,
  "wowgoBase": {
    "repository": "https://github.com/taiwanhua/wowgo-base.git",
    "tag": "v0.3.3",
    "commit": "da45cdbae2e1c20d4bbc30d0936cd2c64739a9f9"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "e2e": "pnpm --filter @repo/e2e e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "@repo/project-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "^3.6.0",
    "terser": "5.49.0",
    "turbo": "^2.10.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@swc/core",
      "esbuild",
      "mongodb-memory-server",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  }
}
