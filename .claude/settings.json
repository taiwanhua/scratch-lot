{
  "permissions": {
    "allow": [
      "Bash(gh workflow run Deploy *)",
      "Bash(bash /c/Users/*/AppData/Local/Temp/claude/*)",
      "Bash(rm -rf /c/project/wt-*)",
      "Bash(rm -rf /c/project/sl-*)",
      "Bash(rm -rf /c/project/base-contrib/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-hooks/post-edit-check.mjs",
            "timeout": 180,
            "statusMessage": "lint + typecheck(三層約束第一層)"
          }
        ]
      }
    ]
  }
}
