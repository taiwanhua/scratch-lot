.DS_Store
node_modules
.turbo
*.log
.next
dist
dist-ssr
*.local
.env
.cache
server/dist
public/dist

# 外部安裝 skill 的 symlink(機器特定,由 `npx skills add` / skills-lock.json 重建)
# 自製的專案 skill 直接放 .claude/skills/<名稱>/,會正常版控
.claude/skills/vercel-react-best-practices
.claude/skills/web-design-guidelines
.claude/skills/writing-guidelines

# Storybook build 產物
storybook-static

# Claude Code 背景 agent 的隔離 worktree(機器特定)
.claude/worktrees/

# Claude Code PostToolUse hook 的本機開關(見 scripts/claude-hooks/post-edit-check.mjs)
.claude/hook-typecheck-off

# Claude Code 的本機設定(每台機器自己的權限允許清單,不入版控;
# 原本只靠使用者層的 global gitignore 擋住,換機器就會誤入版控 — #195 → #160)
.claude/settings.local.json

# Codex 本機設定與交接；正式決策留在版控文件及 issue/PR
.codex/

# 從 repo 根跑 api 時 NestJS 會在根目錄誤生一份 schema.gql(正本在 apps/api/schema.gql)
/schema.gql

# e2e(apps/e2e)的執行期產物:harness 起 stack 用的暫存(api log、記憶體 Mongo)與 Playwright 報告
apps/e2e/.tmp
apps/e2e/playwright-report
apps/e2e/test-results

# figma-sync 的暫存 run(request / inventory / plan / attempt 與生成 JS);成功狀態另存 deploy/project/figma/receipts/、要 commit
.artifacts/figma-sync/

# 本機 Figma 外掛的可丟棄品牌 JSON 與測試截圖
.artifacts/figma-local/
