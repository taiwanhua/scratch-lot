{
  "name": "@repo/project-config",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "description": "專案公開設定:品牌、穩定識別、信件寄件識別。`src/base/` 是底座契約與純函式,`src/project/` 是專案值;不依賴框架、UI、i18n 或機密",
  "files": [
    "dist"
  ],
  "exports": {
    "./public": {
      "import": {
        "types": "./dist/es/public.d.ts",
        "default": "./dist/es/public.js"
      },
      "require": {
        "types": "./dist/cjs/public.d.cts",
        "default": "./dist/cjs/public.cjs"
      }
    },
    "./mail": {
      "import": {
        "types": "./dist/es/mail.d.ts",
        "default": "./dist/es/mail.js"
      },
      "require": {
        "types": "./dist/cjs/mail.d.cts",
        "default": "./dist/cjs/mail.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "public": [
        "./dist/es/public.d.ts"
      ],
      "mail": [
        "./dist/es/mail.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "lint": "eslint src/ --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "bunchee": "^6.4.0",
    "eslint": "^9.39.0",
    "jest": "^30.5.2",
    "typescript": "5.9.3"
  }
}
