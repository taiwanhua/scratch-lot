{
  "name": "@repo/graphql",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist/**",
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "generate": "node scripts/check-documents.mjs && graphql-codegen --config codegen.ts && node scripts/fix-generated.mjs",
    "build": "bunchee",
    "dev": "bunchee --watch",
    "check-types": "tsc --noEmit",
    "test:documents": "node --test scripts/check-documents.test.mjs scripts/generated-documents.test.mjs",
    "lint": "eslint src/ --max-warnings 0"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-react-query": "^6.1.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "bunchee": "^6.4.0",
    "eslint": "^9.39.0",
    "react": "^19.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  }
}
